# =============================================================================
# TTS_MultiModel — Environment Variables for Sensitive Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# The .env file is automatically loaded by config.py at startup.
# System environment variables always take precedence over .env entries.
#
# P1 安全修复：.env 中的旧 VAPID 私钥已被视为已污染并废弃。
# 如需使用 Web Push 通知功能，请自行生成新的密钥对：
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys()"
# 生成后仅将公钥放入 .env，私钥文件应存放在安全的密钥管理系统中。
# pre-commit 已配置禁止提交包含 PRIVATE KEY 标记的文件。
# =============================================================================
# VAPID keys (OPTIONAL — only needed if you enable Web Push notifications)
# VAPID_PUBLIC_KEY=your-public-key-here
# VAPID_PRIVATE_KEY_FILE=/path/to/secure/keyfile  # 私钥文件路径，不直接放入 .env

# =============================================================================
# 日志配置（环境变量覆盖，优先级高于 config.yaml）
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_PATH=logs/app.log

# =============================================================================
# 模型来源模式配置（新增，对齐 Image_MultiModel）
# =============================================================================
# 模型来源模式：portable（内置）或 shared（外部共享目录）
TTS_MODEL_MODE=portable

# 共享模型目录（仅当 TTS_MODEL_MODE=shared 时使用）
# Windows 示例：D:/AIModels/TTS
# macOS/Linux 示例：/opt/ai-models/tts 或 ~/AIModels/TTS
TTS_SHARED_MODELS_ROOT=

# =============================================================================
# CSRF 密钥（安全相关，默认不需要设置）
# =============================================================================
# CSRF HMAC 密钥持久化在 data/.csrf_secret。写不出来时应用默认**拒绝启动**，
# 不再静默降级成无签名模式。只有确实无法提供可写 data/ 的只读部署才需要打开：
# 设为 1 表示改用内存态密钥，代价是每次重启后所有已下发的 CSRF token 失效。
# TTS_ALLOW_EPHEMERAL_CSRF=1
